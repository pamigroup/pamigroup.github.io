---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ '' | absolute_url }}</link>
    <atom:link href="{{ 'feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {%- for n in site.data.news limit: 30 %}
    {%- comment %} date 可能是 'YYYY' 或 'YYYY-MM'，补齐成可解析的完整日期 {% endcomment %}
    {%- assign dp = n.date | append: '-01-01' | split: '-' %}
    {%- assign full = dp[0] | append: '-' | append: dp[1] | append: '-' | append: dp[2] %}
    {%- assign slug = n.text | markdownify | strip_html | strip | slugify | truncate: 48, '' %}
    <item>
      <title>{{ n.text | markdownify | strip_html | strip | truncatewords: 20 | xml_escape }}</title>
      <description>{{ n.text | markdownify | strip_html | strip | xml_escape }}</description>
      <link>{{ '/news' | absolute_url }}</link>
      <pubDate>{{ full | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
      <guid isPermaLink="false">pami-news-{{ n.date }}-{{ slug }}</guid>
    </item>
    {%- endfor %}
  </channel>
</rss>
